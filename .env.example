# ------------------------------------------------------------------
# EventHub – example environment file.
# Copy to `.env` (which is git-ignored) and fill in real values.
# NEVER commit real secrets. Rotate any secret that has ever leaked.
# ------------------------------------------------------------------

# --- MongoDB connection strings (one database per service) ---
USER_MONGODB_URI=mongodb://mongo:27017/userdb
EVENT_MONGODB_URI=mongodb://mongo:27017/eventdb
TICKET_MONGODB_URI=mongodb://mongo:27017/ticketdb
PAYMENT_MONGODB_URI=mongodb://mongo:27017/paymentdb

# --- JWT signing secret ---
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be long and random. There is NO default any more; services refuse to start without it.
JWT_SECRET=

# --- Internal service-to-service key ---
# Shared secret the API Gateway sends to the backend services so they only
# accept traffic that came through the gateway. Generate the same way as JWT_SECRET.
INTERNAL_API_KEY=

# --- CORS allow-list (comma separated origins the browser app is served from) ---
CORS_ORIGINS=http://localhost:5173,http://localhost

# --- First admin account, created once on user-service start-up if no admin exists ---
ADMIN_BOOTSTRAP_EMAIL=admin@eventhub.local
ADMIN_BOOTSTRAP_PASSWORD=

# --- Google OpenID Connect (Sign in with Google) ---
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console.
# Authorised redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:7000/api/users/auth/google/callback
# Where the user is sent back in the SPA after a successful Google login:
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/oauth/callback
